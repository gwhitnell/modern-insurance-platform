/// Policy attributes used to segment claim results, at one row per policy identifier.
table Policy
	lineageTag: 26b52b07-1c88-4bb1-9ae8-851bb160af97

	/// Relationship key retained for model joins.
	column 'Policy ID'
		dataType: string
		isHidden
		lineageTag: df7a3f77-8d14-413b-b378-1ce4317ec76c
		summarizeBy: none
		sourceColumn: Policy ID

	/// Insurance product associated with the policy.
	column Product
		dataType: string
		lineageTag: 7c11bf8c-9e68-4ec5-a7d2-c06135462337
		summarizeBy: none
		sourceColumn: Product

	/// Current policy lifecycle status.
	column 'Policy Status'
		dataType: string
		lineageTag: 762b4628-977b-451c-bd19-1fbcf91edf0b
		summarizeBy: none
		sourceColumn: Policy Status

	partition Policy = m
		mode: import
		source =
				let
					Source = Snowflake.Databases(#"SnowflakeServer", #"SnowflakeWarehouse", [Implementation="2.0"]),
					Database = Source{[Name=#"SnowflakeDatabase"]}[Data],
					Schema = Database{[Name=#"SnowflakeSchema", Kind="Schema"]}[Data],
					PolicySource = Schema{[Name="DIM_POLICY", Kind="Table"]}[Data],
					#"Selected Columns" = Table.SelectColumns(PolicySource, {"POLICY_ID", "PRODUCT_CODE", "POLICY_STATUS"}),
					#"Renamed Columns" = Table.RenameColumns(#"Selected Columns", {{"POLICY_ID", "Policy ID"}, {"PRODUCT_CODE", "Product"}, {"POLICY_STATUS", "Policy Status"}}),
					#"Changed Types" = Table.TransformColumnTypes(#"Renamed Columns", {{"Policy ID", type text}, {"Product", type text}, {"Policy Status", type text}})
				in
					#"Changed Types"

